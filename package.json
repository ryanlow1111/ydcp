{
  "name": "ydcp",
  "private": true,
  "version": "0.0.1",
  "description": "YDCP — Your Desktop Companion Project: an open-source 3D desktop companion for macOS and Windows.",
  "license": "MIT",
  "author": "Ryan Low Jun Yen",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanlow1111/ydcp.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "test": "vitest run --dir tests",
    "check:version": "node scripts/check-version.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check": "npm run lint && npm run test && npm run check:version && npm run check:privacy"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "@pixiv/three-vrm-animation": "3.5.5",
    "@tauri-apps/api": "2.12.4",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
