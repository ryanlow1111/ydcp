{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the YDCP window may do. Kept as small as possible; see the Privacy section of the README. No dialog, file-system, shell or network permissions: file pickers run in Rust only.",
  "windows": ["main"],
  "permissions": [
    "core:app:allow-version",
    "core:event:default",
    "core:window:allow-show",
    "core:window:allow-outer-position",
    "core:window:allow-scale-factor",
    "core:window:allow-set-position",
    "allow-models-folder",
    "allow-list-models",
    "allow-read-model",
    "allow-read-profile",
    "allow-list-anims",
    "allow-read-anim",
    "allow-read-motions",
    "allow-read-lines",
    "allow-set-click-through",
    "allow-current-model",
    "allow-frame-rate",
    "allow-app-language",
    "allow-pet-scale",
    "allow-set-pet-scale",
    "allow-break-every",
    "allow-chattiness",
    "allow-memory",
    "allow-remember",
    "allow-set-timer-left",
    "allow-show-pet",
    "allow-saved-outfit",
    "allow-sort-outfit",
    "allow-set-catalogue",
    "allow-add-model"
  ]
}
