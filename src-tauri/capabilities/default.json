{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the YDCP window may do. Kept as small as possible; see the Privacy section of the README. No dialog, file-system, shell or network permissions: file pickers run in Rust only.",
  "windows": ["main"],
  "permissions": [
    "core:app:allow-version",
    "core:event:default",
    "core:window:allow-show",
    "core:window:allow-outer-position",
    "core:window:allow-scale-factor",
    "core:window:allow-set-position",
    "allow-models-folder",
    "allow-list-models",
    "allow-read-model",
    "allow-read-profile",
    "allow-list-anims",
    "allow-read-anim",
    "allow-read-motions",
    "allow-set-click-through",
    "allow-current-model",
    "allow-frame-rate",
    "allow-saved-outfit",
    "allow-set-catalogue",
    "allow-add-model"
  ]
}
