{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "YDCP",
  "version": "../package.json",
  "identifier": "io.github.ryanlow1111.ydcp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YDCP",
        "width": 420,
        "height": 320,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost blob: data:; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "publisher": "Ryan Low Jun Yen",
    "copyright": "Copyright © 2026 Ryan Low Jun Yen. MIT License.",
    "category": "Entertainment",
    "shortDescription": "Your Desktop Companion Project",
    "longDescription": "An open-source 3D desktop companion for macOS and Windows. Bring your own VRM model. No account, no internet, no tracking.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
